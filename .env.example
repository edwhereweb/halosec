APP_ENV=production
APP_NAME=HaloSec
APP_URL=https://halosec.in
CONTACT_EMAIL=hello@halosec.in
EMERGENCY_PHONE=+917356543520

# MySQL/MariaDB (hPanel → Databases). Keep this file outside public/ and chmod 600.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Or a full DSN instead of the four lines above:
# DB_DSN=mysql:host=localhost;dbname=halosec;charset=utf8mb4

# Optional: create the first admin during `php bin/admin.php migrate` (only if that user doesn't exist).
# Hash: php bin/admin.php hash 'your-long-password'   (quote the value; it contains $ signs)
# Easier: leave blank and run  php bin/admin.php create <user> '<password>' super_admin
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_ROLE=super_admin

# Force every admin to set up two-factor authentication before using the dashboard.
ADMIN_REQUIRE_2FA=false
# Time zone for dates shown in the admin area (stored times stay UTC)
ADMIN_TIMEZONE=Asia/Kolkata

# Only set to true when the site is proxied through Cloudflare. Otherwise visitors could fake their IP.
TRUST_CLOUDFLARE=false

# Days of database backups to keep in storage/backups (see docs/deploy-hostinger.md for cron).
BACKUP_KEEP_DAYS=14

# Founder video on homepage (YouTube video ID or URL, e.g. dQw4w9WgXcQ)
FOUNDER_VIDEO_ID=

# Public business details used in search-engine structured data (optional; leave blank until real)
BUSINESS_STREET=
BUSINESS_CITY=
BUSINESS_REGION=
BUSINESS_POSTAL_CODE=
BUSINESS_COUNTRY=IN
BUSINESS_AREA_SERVED=India
# Comma-separated public profile URLs (LinkedIn company page, etc.)
SOCIAL_LINKS=

# Privacy (GDPR / DPDP). Shown on /privacy; blanks show as [TO COMPLETE]. See docs/privacy-compliance.md.
BUSINESS_LEGAL_NAME=
# Where privacy requests go (defaults to CONTACT_EMAIL)
PRIVACY_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_PHONE=
# e.g. "Hostinger International Ltd, servers in India"
HOSTING_PROVIDER=
# Submissions older than this are deleted by `php bin/admin.php retention` (cron). Minimum 30.
RETENTION_DAYS=730
