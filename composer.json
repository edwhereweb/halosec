{
    "name": "edwhereweb/halosec",
    "description": "HaloSec multi-page marketing website",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "psr-4": {
            "HaloSec\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HaloSec\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
