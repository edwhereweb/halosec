# HaloSec Root-Level Security & Routing Wrapper for Shared Hosting
# Hostinger Git deployment clones the whole repository into public_html, so this file is the
# front door: it blocks internal folders and serves everything else from public/.
Options -Indexes -MultiViews

# 1. Deny direct access to dotfiles (.env, .git, etc.)
<FilesMatch "^\.(env|git|htaccess|htpasswd)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Deny direct access to configuration and database dump files
<FilesMatch "\.(sql|log|json|lock|dist|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Safe routing to public/ if document root is set to the repository root
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to internal core directories
    RewriteRule ^(src|config|views|storage|tests|database|bin|vendor|docs|designref|resources|node_modules|\.git|\.github)(/|$) - [F,L]

    # One host for search engines: send www to the bare domain
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Enforce HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Forward to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
